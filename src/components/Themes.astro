<section
  id="temas"
  class="relative bg-background-landing text-white px-6 md:px-20 lg:px-32 py-24 flex flex-col items-center text-center"
>
  <div class="absolute inset-0 bg-white/5"></div>
  <div class="relative z-10 max-w-6xl w-full">
    <h2 class="font-alt text-3xl mb-4">Temas do Gêmeo Digital de Niterói</h2>
    <p class="text-textMuted mb-14">
      Explore as diferentes áreas e aplicações do nosso gêmeo digital, cada uma focada em aspectos específicos da gestão urbana.
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-y-10">
      {[
        { icon: "/assets/icons/mob-landing.svg", title: "Mobilidade Urbana", text:"Coleta e integração de dados de múltiplas fontes: sensores IoT, satélites, sistemas municipais e comportamento populacional." },
        { icon: "/assets/icons/cloudy.svg", title: "Resiliência Climática", text:"Coleta e integra dados de múltiplas fontes: sensores IoT, satélites, sistemas municipais e comportamento populacional." },
        { icon: "/assets/icons/investment.svg", title: "Atração de Investimentos", text:"Coleta e integra dados de múltiplas fontes: sensores IoT, satélites, sistemas municipais e comportamento populacional." },
        { icon: "/assets/icons/art-culture.svg", title: "Cultura", text:"Coleta e integra dados de múltiplas fontes: sensores IoT, satélites, sistemas municipais e comportamento populacional." },
        { icon: "/assets/icons/citzen-service.svg", title: "Atendimento ao Cidadão", text:"Coleta e integra dados de múltiplas fontes: sensores IoT, satélites, sistemas municipais e comportamento populacional." },
        { icon: "/assets/icons/security.svg", title: "Segurança Pública", text:"Coleta e integra dados de múltiplas fontes: sensores IoT, satélites, sistemas municipais e comportamento populacional." },
      ].map(({ icon, title, text }) => (
        <div class="bg-background-gray/10 p-8 hover:bg-background-gray/20 transition rounded-3xl lg:w-80">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <img src={icon} alt={title} class="h-8 w-8" />
              <h3 class="text-lg font-semibold pt-2">{title}</h3>
            </div>
            <p class="text-textMuted text-md leading-relaxed mb-4 text-start">{text}</p>
          </div>
          <button class="text-center gap-2 px-6 py-3 rounded-full border border-white
              hover:bg-highlight-cyan hover:text-background-landing hover:border-black transition
              mx-auto md:mx-0 w-10/12 ">Explorar tema</button>
        </div>
      ))}
    </div>
  </div>
</section>