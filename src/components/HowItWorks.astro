<section
  id="how-it-works"
  class="relative bg-background-landing text-white px-6 md:px-20 lg:px-32 py-24 flex flex-col items-center text-center"
>
  <div class="relative z-10 max-w-6xl w-full">
    <h2 class="font-alt text-3xl mb-14">Como funciona o Gêmeo Digital</h2>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-y-10">
      {[
        { icon: "/assets/icons/database.svg", title: "Integração de dados", text: "Coleta e integração de dados de múltiplas fontes: sensores IoT, satélites, sistemas municipais e comportamento populacional." },
        { icon: "/assets/icons/bar-graph.svg", title: "Análise em Tempo Real", text: "Processamento e análise contínua de dados para insights imediatos sobre o funcionamento da cidade." },
        { icon: "/assets/icons/map.svg", title: "Visualização 3D", text: "Modelo tridimensional interativo que representa fielmente a geografia e infraestrutura urbana." },
        { icon: "/assets/icons/bolt.svg", title: "Otimização Automática", text: "Algoritmos inteligentes que sugerem melhorias na gestão de recursos e planejamento urbano." },
        { icon: "/assets/icons/shield.svg", title: "Monitoramento de Segurança", text: "Vigilância contínua da infraestrutura crítica e sistemas de emergência da cidade." },
        { icon: "/assets/icons/world.svg", title: "Sustentabilidade", text: "Análise do impacto ambiental e sugestões para desenvolvimento urbano sustentável." },
      ].map(({ icon, title, text }) => (
        <div class="bg-background-landingThemes border border-background-gray hover:border-highlight-cyan transition
                    pt-4 pb-5 pl-5 rounded-3xl hover:bg-background-landingButton text-center place-items-start
                    lg:w-80
                    flex flex-col">
          <div class="flex items-center gap-2 mb-3 mx-2">
            <img src={icon} alt={title} class="h-8 w-8" />
            <h3 class="font-semibold text-lg text-left pt-1">{title}</h3>
          </div>
          <p class="text-textMuted text-sm leading-relaxed w-10/12 justify-between text-left ml-3">{text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
