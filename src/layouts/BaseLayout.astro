---
const { title = "Gêmeo Digital" } = Astro.props;
import "../styles/fonts.css";
---

<html lang="pt-BR" class="bg-background-landing text-text font-primary">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />
  </body>
</html>
