---
import logoGemeo from "../assets/images/gemeo-digital.svg";
import arrowDown from "../assets/icons/arrow_downward.svg";
import ilustracao from "../assets/images/ilustracao.avif";
import { Image } from "astro:assets";

const indicadores = [
  {
    value: "XX +",
    label: "interações de dados",
  },
  {
    value: "24h",
    label: "monitoramento",
  },
  {
    value: "Tempo real",
    label: "atualização",
  },
];
---

<section
  class="relative flex justify-center items-center text-white bg-background-landing px-4 py-12"
  aria-label="Seção principal de apresentação do Gêmeo Digital"
>
  <div
    class="flex flex-col md:flex-row items-center justify-between gap-10 w-full max-w-6xl"
    aria-label="Conteúdo dividido entre texto e imagem ilustrativa"
  >
    <article
      class="flex flex-col gap-6 text-center md:text-left max-w-lg order-2 md:order-1"
      aria-labelledby="hero-title"
      aria-describedby="hero-description"
    >
      <header aria-label="Identidade visual">
        <img
          src={logoGemeo.src}
          alt="Logo Gêmeo Digital"
          class="h-20 w-auto md:h-32 mx-auto md:mx-0"
        />
      </header>

      <p id="hero-description" class="text-lg text-textMuted">
        Uma representação virtual dinâmica e interativa que integra dados em
        tempo real para planejar, monitorar e melhorar a vida urbana.
      </p>

      <figure
        class="block md:hidden mt-6"
        aria-label="Visualização ilustrativa do Gêmeo Digital"
      >
        <img
          src={ilustracao.src}
          alt="Ilustração representando o conceito do Gêmeo Digital"
          class="h-44 mx-auto"
        />
      </figure>

      <nav
        class="flex flex-col md:hidden"
        aria-label="Navegação principal em dispositivos móveis"
      >
        <a
          href="https://dados-app.niteroi.rj.gov.br/gemeo-digital/"
          aria-label="Ir para a aplicação"
          class="reveal flex items-center justify-center gap-2 px-6 py-3 rounded-full
                border border-white/20 bg-background-landingButton
                hover:bg-highlight-cyan hover:text-background-landing mt-6 mx-auto"
        >
          Visite a aplicação
          <img src={arrowDown.src} alt="" aria-hidden="true" class="h-5 w-5" />
        </a>

        <a
          onclick="window.location.href='doc'"
          aria-label="Acessar documentação do Gêmeo Digital"
          class="reveal flex items-center justify-center gap-2 px-8 py-3 rounded-full
                border border-white/20 bg-background-landingButton
                hover:bg-highlight-cyan hover:text-background-landing transition mt-6 mx-auto"
        >
          Documentação
          <img src={arrowDown.src} aria-hidden="true" class="h-5 w-5 -rotate-90" />
        </a>
      </nav>

      <section
        class="reveal flex flex-col sm:flex-row justify-center md:justify-start gap-6 mt-6"
        aria-label="Indicadores de desempenho do GǦmeo Digital"
      >
        {
          indicadores.map((item) => (
            <div class="flex flex-col" aria-label={item.label}>
              <h3 class="text-highlight-cyan font-semibold text-xl">
                {item.value}
              </h3>
              <p class="text-textMuted">{item.label}</p>
            </div>
          ))
        }
      </section>

      <nav class="hidden md:flex gap-4" aria-label="Navegação principal">
        <a
          href="https://dados-app.niteroi.rj.gov.br/gemeo-digital/"
          aria-label="Ir para a aplicação"
          class="reveal flex items-center justify-center gap-2 px-6 py-3 rounded-full
                border border-white/20 bg-background-landingButton
                hover:bg-highlight-cyan hover:text-background-landing mt-4"
        >
          Visite a nossa aplicação
          <img src={arrowDown.src} alt="" aria-hidden="true" class="h-5 w-5 rotate-180" />
        </a>
        
        <a
          onclick="window.location.href='doc'"
          aria-label="Acessar documentação do Gêmeo Digital"
          class="reveal flex items-center justify-center gap-2 px-6 py-3 rounded-full
                 border border-white/20 bg-background-landingButton
                 hover:cursor-pointer
                 hover:bg-highlight-cyan hover:text-background-landing mt-4"
        >
          Documentação
          <img src={arrowDown.src} alt="" aria-hidden="true" class="h-5 w-5 -rotate-90" />
        </a>
      </nav>
    </article>

    <figure
      class="reveal hidden md:flex justify-center md:justify-end order-1 md:order-2 w-full md:w-auto"
      aria-label="Imagem ilustrativa principal do Gêmeo Digital"
    >
      <Image
        src={ilustracao}
        alt="Ilustração do Gêmeo Digital mostrando uma cidade conectada por dados"
        class="w-auto mx-auto md:mx-0"
        format="avif"
      />
    </figure>
  </div>
</section>
<script>
  const DATA_BASE = new Date("2025-11-01T00:00:00Z").getTime();  

  const INTERVALO = 30 * 1000;
  function getContadorInicial() {
    const agora = Date.now();
    const diff = agora - DATA_BASE;
    return Math.floor(diff / INTERVALO);
  }

  let contador = getContadorInicial();

  function atualizarHero() {
    const cards = document.querySelectorAll("[aria-label='interações de dados'] h3");
    cards.forEach((el) => {
      el.textContent = `${contador.toLocaleString("pt-BR")} +`;
    });
  }

  atualizarHero();

 
  setInterval(() => {
    contador++;
    atualizarHero();
  }, INTERVALO);
</script>
