---
import iconDistance from "../assets/icons/distance.svg";
import iconDrafts from "../assets/icons/drafts.svg";
import logoGemeoMob from "../assets/images/logo-gemeo-mob.svg";
---

<footer
  id="footer"
  class="reveal bg-background-landing text-secundary text-sm md:p-16 p-8"
  aria-labelledby="footer-title"
>
  <section class="flex flex-col relative w-full max-w-7xl mx-auto">

    <div
      class="flex flex-col mb-12 mt-4 w-full gap-20 justify-evenly
             md:flex-row lg:pl-12 md:pr-16"
    >
      <figure
        class="flex justify-center md:justify-start"
        aria-label="Logo institucional"
      >
        <img
          src={logoGemeoMob.src}
          alt="Logo do Gêmeo Digital de Niterói"
          class="h-24 w-auto lg:h-32 md:mx-8"
        />
      </figure>

      <nav
        class="flex flex-col text-left text-white min-w-[180px]"
        aria-label="Links Úteis"
      >
        <h2 class="font-semibold text-xl mb-3">Links úteis</h2>

       <ul class="flex flex-col gap-2 text-sm">
          <li>
            <a href="https://urbanismo.niteroi.rj.gov.br/" class="hover:text-highlight-cyan" target="_blank" rel="noopener">
              SMU — Urbanismo
            </a>
          </li>

          <li>
            <a href="https://www.mobnit.com.br/" class="hover:text-highlight-cyan" target="_blank" rel="noopener">
              SEMOBI / MobNit
            </a>
          </li>

          <li>
            <a href="https://defesacivil.niteroi.rj.gov.br/" class="hover:text-highlight-cyan" target="_blank" rel="noopener">
              Defesa Civil — SVIDA
            </a>
          </li>

          <li>
            <a href="https://nittrans.niteroi.rj.gov.br/" class="hover:text-highlight-cyan" target="_blank" rel="noopener">
              NitTrans
            </a>
          </li>

          <li>
            <a href="https://dados.niteroi.rj.gov.br/" class="hover:text-highlight-cyan" target="_blank" rel="noopener">
              Escritório de Dados
            </a>
          </li>

          <li>
            <a href="https://niteroi.rj.gov.br/" class="hover:text-highlight-cyan" target="_blank" rel="noopener">
              Prefeitura de Niterói
            </a>
          </li>
          <li>
            <a
              href="https://github.com/niteroi-prefeitura"
              class="hover:text-highlight-cyan transition"
              target="_blank"
              rel="noopener"
            >
              GitHub
            </a>
          </li>
        </ul>
      </nav>

      <address
        class="flex flex-col gap-3 not-italic text-left text-white xl:mr-32"
        aria-labelledby="footer-title"
      >
        <h2 class="font-semibold text-xl mb-1">Contato</h2>

        <div class="flex items-center gap-2">
          <img
            src={iconDrafts.src}
            alt=""
            aria-hidden="true"
            class="h-4 w-4 opacity-90"
          />
          <a
            href="mailto:contato@sigeo.niteroi.rj.gov.br"
            class="hover:text-highlight-cyan transition"
          >
            contato@sigeo.niteroi.rj.gov.br
          </a>
        </div>

        <div class="flex items-center gap-2">
          <img
            src={iconDistance.src}
            alt=""
            aria-hidden="true"
            class="h-4 w-4 opacity-90"
          />
          <p>Niterói, RJ — Brasil</p>
        </div>
      </address>
    </div>

    <div class="h-[1px] w-full bg-primary/30 mb-8" aria-hidden="true"></div>

    <nav
      class="flex flex-col md:flex-row justify-between items-center text-center gap-6 text-white/80 font-primary"
      aria-label="Links institucionais e direitos autorais"
    >
      <div class="flex flex-wrap justify-center md:justify-start gap-4 text-xs md:text-sm">
        <p>© 2025 Gêmeo Digital de Niterói. Todos os direitos reservados.</p>
        
      </div>

      <p class="flex text-end text-xs md:text-sm">
        Feito para cidades inteligentes
      </p>
    </nav>
  </section>
</footer>
